[Unit]
Description=Vyom daemon - keyboard-driven panels for Wayland
Documentation=https://github.com/Theyashsawarkar/vyom
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vyom daemon
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=graphical-session.target
