{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "black",
      "2": "red",
      "3": "green",
      "4": "yellow",
      "5": "blue",
      "6": "magenta",
      "7": "cyan",
      "8": "white"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  "
  },
 "modules": [
    "title",
    "separator",
    "os",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
