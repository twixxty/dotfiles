#!/bin/bash

SELECTION="$(printf "󰌾 Lock\n󰒲 Suspend\n󰩈 Exit Niri\n󰜉 Reboot\n󰍃 Log-out\n󰐥 Shutdown" | fuzzel --dmenu -l 6 -p "Power Menu: ")"

case "$SELECTION" in
	*"Lock")
		hyprlock ;;
	*"Suspend")
		hyprlock & sleep 1; loginctl suspend ;;
	*"Exit Niri")
		niri msg action quit ;;
	*"Reboot")
		loginctl reboot ;;
	*"Log-out")
		loginctl terminate-user "$USER" ;;
	*"Shutdown")
		loginctl poweroff ;;
esac
